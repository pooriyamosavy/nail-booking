# MongoDB — in HamDocker/K8s use the internal DB hostname, e.g.:
# mongodb://root:<password>@<db-service-name>:27017/my-app?authSource=admin
MONGODB_URI=mongodb://localhost:27017/nail-booking

ADMIN_PASSWORD=change-me
ADMIN_PHONE=09000000000
JWT_SECRET=change-me-to-a-long-random-secret

# false = use real MongoDB; true = in-memory mock (local only)
USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK_DATA=false

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
