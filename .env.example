# Production / HamDocker — set these in the app Environment UI (do not commit secrets).
# Internal DB hostname only resolves inside the cluster:
MONGODB_URI=mongodb://root:<DB_PASSWORD>@vigorous-mayer-vdzqizqjt-db:27017/my-app?authSource=admin

ADMIN_PASSWORD=change-me
ADMIN_PHONE=09000000000
JWT_SECRET=change-me-to-a-long-random-secret

# Must be false when using real MongoDB
USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK_DATA=false

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
