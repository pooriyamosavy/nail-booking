# Liara MongoDB (set real password in .env.local / deploy panel — never commit secrets)
MONGODB_URI=mongodb://root:<PASSWORD>@rainier.liara.cloud:32635/my-app?authSource=admin

# Required
ADMIN_PASSWORD=change-me
ADMIN_PHONE=09000000000
JWT_SECRET=change-me-to-a-long-random-secret

# Must be false when using real MongoDB
USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK_DATA=false

# Web Push (optional — npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
